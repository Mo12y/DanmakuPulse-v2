# 数据与产物不进 git（对齐旧仓库惯例，data 由 backup 脚本单独存档）
data/
logs/
data-out/
lib/*.jar
serve/static/vendor/
__pycache__/
*.pyc
.venv/
.DS_Store
# 自签证书与私钥（make tls-cert 生成）
compose/assets/tls/
# LLM 密钥（AI 报告解读）：**不进 git**
# ⚠️ compose/.env 是被 git 跟踪的，所以密钥单独放这个文件，由 fastapi 服务的
#    env_file（required: false）注入；见 compose/docker-compose.b0.yml 的 fastapi 段。
compose/.env.llm

# ── 本地保留文档、不入库（2026-10-30）──
docs/
screenshots/
*.md
*.docx
*.pdf
*.zip
