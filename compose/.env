# docker-compose.b0.yml 环境变量（B0 最小 9 服务底座）
# 内存预算合计 ≈4.6GB（7.7GB VM 上：+GNOME/系统 ≈1GB，余 ≈2GB headroom + 12G swap 安全网）
# B1 叠加 compose/docker-compose.obs.yml（DS standalone + Prometheus/Grafana/cAdvisor + DataNode2/Worker2）

# ── 镜像（DockerHub 直连不通，daemon.json 已配 daocloud/1ms.run 镜像源）──
SPARK_IMAGE=danmaku-spark:3.5.4-py
HADOOP_NN_IMAGE=bde2020/hadoop-namenode:2.0.0-hadoop3.2.1-java8
HADOOP_DN_IMAGE=bde2020/hadoop-datanode:2.0.0-hadoop3.2.1-java8
# 官方 apache/spark-py 被镜像源拒绝，自建派生镜像（compose/assets/spark-docker）
HIVE_IMAGE=bde2020/hive-metastore-postgresql:2.3.0
PG_IMAGE=postgres:15-alpine

# ── PostgreSQL（Hive 元库 + ads 库共用一实例，不复用旧系统 MySQL）──
POSTGRES_USER=danmaku
POSTGRES_PASSWORD=change-me
PG_PORT=5433

# ── 端口（宿主访问：Windows 浏览器 → http://192.168.88.100:<port>）──
NGINX_PORT=8088
SPARK_UI_PORT=8080
SPARK_WORKER_UI_PORT=8081
SPARK_HISTORY_PORT=18080
HDFS_UI_PORT=9870
FASTAPI_PORT=8000

# ── Spark 资源（单 Worker：executor 1g / 2 cores；driver 512m 住 master 容器）──
SPARK_WORKER_MEMORY=1g
SPARK_WORKER_CORES=2
SPARK_DRIVER_MEMORY=512m
SPARK_EXECUTOR_MEMORY=1g
