# bde2020 hadoop 镜像约定：CORE_CONF_xxx / HDFS_CONF_xxx 环境变量 → 自动写入对应 xml
CORE_CONF_fs_defaultFS=hdfs://namenode:9000
CORE_CONF_hadoop_http_staticuser_user=root
HDFS_CONF_dfs_webhdfs_enabled=true
HDFS_CONF_dfs_permissions_enabled=false
# B0 单 DataNode ⇒ 副本数必须为 1（B1 加 DataNode2 后可调 2）
HDFS_CONF_dfs_replication=1
# 容器 IP 漂移导致的 DN 注册校验失败（实测常见坑）
HDFS_CONF_dfs_namenode_datanode_registration_ip___host___check=false
